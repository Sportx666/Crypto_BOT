# ── Hyperliquid credentials ───────────────────────────────────────────────
# Your EVM wallet address (0x…)
HL_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS

# Private key for the agent/trading wallet (0x…)
# Use a dedicated sub-account key, never your main wallet!
HL_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# ── Network ───────────────────────────────────────────────────────────────
# true  → testnet (safe, recommended first)
# false → mainnet (real money!)
TESTNET=true

# true  → log signals but never send orders
# false → live execution
DRY_RUN=true

# ── Risk ──────────────────────────────────────────────────────────────────
RISK_PCT=0.0025           # 0.25% equity at risk per trade
MAX_RISK_PCT=0.005        # hard cap 0.5%
MAX_CONCURRENT_POSITIONS=3
DEFAULT_LEVERAGE=3

DAILY_LOSS_PCT=0.01       # halt after losing 1% in a day
WEEKLY_LOSS_PCT=0.03      # halt after losing 3% in a week
COOLDOWN_AFTER_STOP_MIN=60

# ── Universe ──────────────────────────────────────────────────────────────
MIN_VOLUME_24H_USD=5000000
MAX_ACTIVE_SYMBOLS=8
UNIVERSE_SCAN_INTERVAL_MIN=15

# ── Strategy ──────────────────────────────────────────────────────────────
ADX_TREND_THRESHOLD=25.0
ATR_PCT_MIN=0.003
ATR_PCT_MAX=0.05
EMA_FAST=9
EMA_SLOW=21
TREND_ATR_SL_MULT=1.5
TREND_TRAIL_ATR_MULT=2.0
RANGE_VWAP_BAND_ATR_MULT=1.5
RANGE_TP_R=1.5

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
JOURNAL_PATH=data/journal.jsonl
STATE_PATH=data/state.json
DAILY_REPORT_HOUR_UTC=0

# ── Legacy Binance (kept for backtest module only) ────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
